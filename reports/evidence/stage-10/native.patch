+namespace s10 {
+using Take=Minisat::CRef(*)(Minisat::Solver*,const Minisat::vec<Minisat::Lit>&);
+using Born=void(*)(Minisat::Solver*,const Minisat::vec<Minisat::Lit>&,Minisat::CRef);
