+// Dedicated structured output for callers that also need the solver's diagnostics.
+static std::unique_ptr<std::ofstream> open_json_output(ui_message_handlert::uit ui)
+{
+  const char *path = std::getenv("INCDEAGLE_JSON_OUTPUT");
+  if(ui != ui_message_handlert::uit::JSON_UI || path == nullptr)
+    return nullptr;
+
+  auto file = util_make_unique<std::ofstream>(path);
+  if(!*file)
+  {
+    std::cerr << "Cannot open INCDEAGLE_JSON_OUTPUT: " << path << '\n';
+    std::exit(EXIT_FAILURE);
+  }
+  return file;
+}
 
