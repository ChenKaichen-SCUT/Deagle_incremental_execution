+++ b/scripts/stage9/reference_gcc.py
@@ -0,0 +1,44 @@
+#!/usr/bin/python3
+"""Acquire the old session's provenance in the ordinary per-invocation interpreter."""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, os.environ['INCDEAGLE_FRONT_MODULE'])
