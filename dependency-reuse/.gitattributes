# Preserve historical blob bytes and the hashes of experiment artifacts on Windows.
bench/** -text
configs/*.json text eol=lf
scripts/*.py text eol=lf
scripts/*.sh text eol=lf
d1/** text eol=lf
tests/d1/** text eol=lf
reports/**/*.json text eol=lf
reports/**/*.gz -text
reports/evidence/d1/**/*.txt text eol=lf
reports/evidence/d1/**/*.sha256 text eol=lf
reports/*.md text eol=lf
